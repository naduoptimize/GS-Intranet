# ============================================================
# GS-Intranet Backend - Environment Template
# Copy this file to `.env` and fill in the values.
# ============================================================

PORT=5000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gs_intranet

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional - blank = mock emails printed to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional - Office 365 login / directory sync
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback
FRONTEND_URL=http://localhost:5173
